APP_NAME=TraceIQ
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local development uses SQLite. For PostgreSQL, replace this with your connection URL.
DATABASE_URL=sqlite:///./bugdiag_local.db
# DATABASE_URL=postgresql+psycopg2://traceiq:CHANGE_ME@localhost:5432/traceiq_db

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

BM25_K1=1.5
BM25_B=0.75
RRF_K=60
DEFAULT_TOP_K=5
MAX_TOP_K=20
SIMILARITY_THRESHOLD=0.78

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.txt,.log,.json,.csv,.md,.py,.java,.js,.ts,.tsx,.jsx,.xml,.yaml,.yml

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
DATASETS_DIR=
